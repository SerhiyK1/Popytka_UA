rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Users collection - temporarily open for authenticated users for debugging
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    
    // Rides collection
    match /rides/{rideId} {
      // Anyone authenticated can read rides
      allow read: if isAuthenticated();
      
      // Only ride creator can create/update/delete
      allow create: if isAuthenticated() && 
        request.auth.uid == request.resource.data.riderId &&
        request.resource.data.keys().hasAll(['riderId', 'fromLocation', 'toLocation', 'departureTime', 'pricePerSeat', 'seatsAvailable']) &&
        request.resource.data.pricePerSeat > 0 &&
        request.resource.data.seatsAvailable > 0 &&
        request.resource.data.seatsAvailable <= 8;
        
      allow update: if isAuthenticated() && 
        request.auth.uid == resource.data.riderId &&
        request.resource.data.riderId == resource.data.riderId; // Prevent riderId change
        
      allow delete: if isAuthenticated() && 
        request.auth.uid == resource.data.riderId;
    }
    
    // Bookings collection
    match /bookings/{bookingId} {
      // Passengers and ride owners can read/write bookings
      allow read, write: if isAuthenticated() && 
        (request.auth.uid == resource.data.passengerId || 
         request.auth.uid == get(/databases/$(database)/documents/rides/$(resource.data.rideId)).data.riderId);
         
      // Create booking validation
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.passengerId &&
        request.resource.data.keys().hasAll(['rideId', 'passengerId', 'seats', 'totalPrice']) &&
        request.resource.data.seats > 0 &&
        request.resource.data.seats <= 4 &&
        request.resource.data.totalPrice > 0;
    }
    
    // Chats collection
    match /chats/{chatId} {
      // Only chat participants can access
      allow read, write: if isAuthenticated() && 
        request.auth.uid in resource.data.participantIds;
        
      // Create chat validation
      allow create: if isAuthenticated() &&
        request.auth.uid in request.resource.data.participantIds &&
        request.resource.data.participantIds.size() == 2;
      
      // Messages subcollection
      match /messages/{messageId} {
        allow read, write: if isAuthenticated() && 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
          
        // Create message validation
        allow create: if isAuthenticated() &&
          request.auth.uid == request.resource.data.senderId &&
          request.resource.data.keys().hasAll(['senderId', 'text', 'createdAt']) &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 1000;
      }
    }
    
    // Driver locations for real-time tracking
    match /driver_locations/{driverId} {
      // Anyone can read driver locations (for passenger tracking)
      allow read: if isAuthenticated();
      
      // Only the driver can update their location
      allow write: if isOwner(driverId) &&
        request.resource.data.keys().hasAll(['driverId', 'latitude', 'longitude', 'updatedAt']) &&
        request.resource.data.latitude is number &&
        request.resource.data.longitude is number &&
        request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90 &&
        request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180;
    }
    
    // Admin collection (for admin users only)
    match /admin/{document=**} {
      allow read, write: if isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}